# ROADGUARD AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="ROADGUARD AI"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database
# Local SQLite default:
DATABASE_URL=sqlite:///./roadguard.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/roadguard_ai

# File Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15

# AI Model Configuration
# Path to road damage YOLO model weights (.pt or .onnx)
# If left empty or file is not found, RoadGuard gracefully uses its internal CV Surface Analysis Engine
MODEL_WEIGHTS_PATH=./models/road_damage_best.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45
